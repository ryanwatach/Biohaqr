# Supabase — find these in your project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres — find these in Settings → Database → Connection string
# Use the "Transaction" mode URL (port 6543) for DATABASE_URL
# Use the "Session" mode URL (port 5432) for DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# Model API key — used by the bloodwork parser and Knowledge Engine
ANTHROPIC_API_KEY=

# Whoop OAuth — developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wearable token encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEARABLE_ENCRYPTION_KEY=
